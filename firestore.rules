rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPlatformAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isTeamOwner(teamId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == request.auth.uid;
    }

    function isTeamMember(teamId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    // Users
    match /users/{userId}/public/profile {
      allow read: if isOwner(userId) || isPlatformAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/private/info {
      allow read, create, update, delete: if isOwner(userId);
    }

    // Teams
    match /teams/{teamId} {
      // A signed-in user may resolve a shared team code. Team data and
      // subcollections become readable only after membership is created.
      allow get: if isSignedIn();
      allow list: if isPlatformAdmin();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isTeamOwner(teamId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isTeamOwner(teamId);
    }

    // Colleagues
    match /teams/{teamId}/colleagues/{colleagueId} {
      allow read, list: if isTeamMember(teamId) || isTeamOwner(teamId) || isPlatformAdmin();
      allow create, update, delete: if isTeamOwner(teamId);
    }

    // Absences
    match /teams/{teamId}/absences/{absenceId} {
      allow read, list: if isTeamMember(teamId) || isTeamOwner(teamId) || isPlatformAdmin();
      allow create, update, delete: if isTeamOwner(teamId);
    }

    // Members
    match /teams/{teamId}/members/{memberId} {
      allow read: if memberId == request.auth.uid || isTeamOwner(teamId) || isPlatformAdmin();
      allow list: if isTeamOwner(teamId) || isPlatformAdmin();
      // Team owner manages all members; any signed-in user can create their own entry (self-join)
      allow create: if isTeamOwner(teamId) || (
        isSignedIn()
        && memberId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == 'viewer'
        && request.resource.data.keys().hasOnly(['userId', 'displayName', 'email', 'role', 'joinedAt'])
      );
      allow update, delete: if isTeamOwner(teamId);
    }

    // CMS
    match /cms/{document} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.admin == true;
    }

    // Stats (connexions & new users per day)
    match /stats/{date} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create, update: if false;
    }

    // Admin collectionGroup access
    match /{path=**}/public/profile {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    match /{path=**}/private/info {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
